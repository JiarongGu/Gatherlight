<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gatherlight.Server.Platform</RootNamespace>
    <AssemblyName>Gatherlight.Platform</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Sources are BOM-less UTF-8; without this, csc on a CJK-locale Windows machine reads
         them via the ANSI codepage and every Chinese string literal becomes mojibake. -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <!-- Controllers, IHostedService, ILogger, Kestrel types. Transitive to consumers. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Microsoft.NET.Sdk.Web (which Gatherlight.Server still uses) auto-adds these implicit global
       usings; the plain classlib SDK does not, even with the FrameworkReference above. This code
       was written assuming them (ILogger<>/LogLevel, IHostedService, HttpContext/RequestDelegate/
       IFormFile, WebApplication) — restore the same set here rather than touch every file. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapper, Microsoft.Data.Sqlite and SQLitePCLRaw.bundle_e_sqlite3 sit at or above the floors
         Lyntai.Storage.Sqlite declares since 3.3.0 (2.1.89 / 10.0.12 / 3.0.5): a direct pin below a
         transitive floor is NU1605, which the SDK treats as an error, so restore fails outright. -->
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- Cron parsing + next-occurrence (timezone/DST aware) for the background-job scheduler.
         Small, dependency-free, well-regarded. -->
    <PackageReference Include="Cronos" Version="0.8.4" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- The NATIVE CPU backend of ONNX Runtime, for BOTH in-process models: the built-in embedder (OnnxEmbedder) and the
         built-in reranker, which runs through Lyntai.Providers.Onnx below. That package references the MANAGED half only
         (Microsoft.ML.OnnxRuntime.Managed >= 1.30.0 at 3.5.1) and leaves the native backend to the app, so this pin has to
         MATCH it: 1.29.0 here would have resolved the managed half to 1.30.0 beside a 1.29.0 native library — no NuGet
         warning (a higher transitive version is no downgrade), a mismatch found only at load. Bumped with it. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <!-- Headless-browser tooling (web-fetch/scrape + future scraper ports). Browser binaries are
         fetched once via `node devtools/dev.mjs fetch-tools`, never at server startup. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <!-- Document/media processing. Properly licensed: PdfPig MIT (PDF text extraction),
         ImageSharp pinned 3.1.x = Apache-2.0 (4.x is the split license). PDF form-fill / merge /
         inspect run on pdf-lib (tools/pdf-form leaves) — reliable on real + CJK PDFs where
         PDFsharp's appearance/import paths throw. Avoid iText (AGPL). -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Direct pin, and today it MIRRORS Lyntai.Storage.Sqlite's own floor (3.0.5), which already
         resolves this version transitively. It was added for a CVE: Microsoft.Data.Sqlite 10.0.0
         pulled SQLitePCLRaw 2.1.11, whose bundled e_sqlite3 was SQLite 3.49.1 (GHSA-2m69-gcr7-jv3q),
         and 3.0.x shipped the patched build. That reason is gone — 10.0.12 pulls 2.1.12, which bundles
         a patched SQLite (3.53.3) — so what the pin records now is the choice to stay on 3.0.x even if
         Lyntai ever drops its floor. Runtime-verified against Microsoft.Data.Sqlite 10. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Lyntai (灵台) — the shared LLM library extracted from this family, consumed from NuGet. LLM-judge
         scorers route through its ITextClient front door + ClaudeCli provider (neutral cwd, verdict-classified,
         router/fallback). The interactive two-gate chat, background jobs, and playground drive the CLI's own
         agent loop through its IAgentSession (ClaudeAgentSession) — read-only/write gates, resume, the
         scope-guard settings file, app-hosted MCP — adapted to the app's SSE wire by AgentRunner.
         Packages are split by DEPENDENCY FOOTPRINT, not vendor: Providers.Basic (renamed from
         Providers.Default in 3.2) holds the CLI and HTTP backends and needs nothing beyond Core. The `Lyntai`
         metapackage is deliberately NOT used: it would pull backends this app never spawns. -->
    <PackageReference Include="Lyntai.Core" Version="3.5.3" />
    <PackageReference Include="Lyntai.Providers.Basic" Version="3.5.3" />
    <!-- The in-process transformer backend (D124/D157/D191): the built-in reranker judge — mmarco-mMiniLMv2 as ONNX, its
         SentencePiece tokenizer read from tokenizer.json by Lyntai's own tokenizer (D191). Managed half only; the native CPU
         backend is Microsoft.ML.OnnxRuntime above. -->
    <PackageReference Include="Lyntai.Providers.Onnx" Version="3.5.3" />
    <!-- Lyntai's SQLite storage backs the scoring store (lyntai_score_result: upsert + aggregate + export),
         landed in the same gatherlight.db (lyntai_-prefixed, coexists with the app's own tables). -->
    <PackageReference Include="Lyntai.Storage.Sqlite" Version="3.5.3" />
    <!-- The ephemeral loopback MCP host Lyntai stands up per one-shot ITextClient call. It reaches ONLY
         the ClaudeCliProvider path, and since 3.4 (D190, McpToolHostOptions.ToolsByConsumer in
         GatherlightApp) only the calls tagged `scorer` — the two LLM-judge scorers — giving them the
         read-only judge tools (Platform/Ops/Scoring/JudgeTools). Through 3.2 it ran on EVERY such call,
         the memory judge's and 语义's rephrasing included. The interactive agent path is untouched: that one gets MCP
         from this server's loopback-only /mcp channel (AgentMcpWiring). The host runs on HttpListener, not
         Kestrel — no ASP.NET framework reference. Lyntai.Tools.Mcp.Hosting folded into this package in 3.2;
         the namespace is unchanged. -->
    <PackageReference Include="Lyntai.Tools.Mcp" Version="3.5.3" />
  </ItemGroup>

</Project>
