<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gatherlight.Server</RootNamespace>
    <AssemblyName>Gatherlight.Server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Sources are BOM-less UTF-8; without this, csc on a CJK-locale Windows machine reads
         them via the ANSI codepage and every Chinese string literal becomes mojibake. -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <!-- PackageReferences live in Gatherlight.Platform now (PackageReference is transitive across a
       ProjectReference); this project depends on that assembly plus Gatherlight.Planner below. -->
  <ItemGroup>
    <ProjectReference Include="..\Gatherlight.Platform\Gatherlight.Platform.csproj" />
  </ItemGroup>

  <!-- Built client (src/client `npm run build` outputs here; gitignored). Copied next to the exe
       so `dotnet run` and any future host serve the same bundle. Absent = dev via Vite. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped site template (knowledge base + site.json manifest) — ZhikuSeeder copies it into new
         data folders. Remove first: the Web SDK default-includes **/*.json outside dot-folders as
         Content on its own (site.json qualifies, routing.json doesn't — it's under .claude/), which
         collides with our own Include below (NETSDK1022) unless we clear it first. -->
    <Content Remove="Assets\SiteTemplate\**" />
    <Content Include="Assets\SiteTemplate\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The capability sandbox preload (Platform/Capabilities/Sandbox) — loaded via node's import
         flag before a sandboxed capability's own code; supplies the network denial Node's
         permission model lacks. Shipped as a build artefact, not embedded, so it stays a single
         verifiable file. BROKEN as of the S4 Platform-assembly extraction: the source now lives in
         Gatherlight.Platform, not here, so this path never resolves and the file no longer lands
         in the output — Condition="Exists(...)" keeps that a silent no-op instead of an MSB3030
         build failure. Deliberately left unfixed: S4 Task 3 re-wires all asset linking (content
         copy is not transitive across a ProjectReference) in one pass. -->
    <Content Include="Platform\Capabilities\Sandbox\Assets\cap-guard.mjs" CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('Platform\Capabilities\Sandbox\Assets\cap-guard.mjs')" />
  </ItemGroup>

</Project>
